{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "github>gucio1200/renovate-config",
    "github>gucio1200/renovate-config:automerge-github-actions",
    "github>gucio1200/home-infra//.github/renovate/allowedVersions.json5",
    "github>gucio1200/home-infra//.github/renovate/autoMerge.json5",
    "github>gucio1200/home-infra//.github/renovate/versioning.json5",
    "github>gucio1200/home-infra//.github/renovate/groups.json5",
    "github>gucio1200/home-infra//.github/renovate/clusters.json5",
    "github>gucio1200/home-infra//.github/renovate/grafanaDashboards.json5",
  ],
  "flux": {
    "fileMatch": ["(k8s|lb)/.+\\.ya?ml$"]
  },
  "helm-values": {
    "fileMatch": ["(k8s|lb)/.+\\.ya?ml$"]
  },
  "kubernetes": {
    "fileMatch": ["(k8s|lb)/.+\\.ya?ml$"]
  },
  "packageRules": [
    {
      "description": "Hold LiteLLM releases for 3 days",
      "matchDatasources": ["docker"],
      "matchPackageNames": ["docker.io/litellm/litellm-non_root", "litellm/litellm-non_root"],
      "minimumReleaseAge": "3 days",
      "internalChecksFilter": "strict"
    }
  ],
 }
