{
  $schema: "https://docs.renovatebot.com/renovate-schema.json",
  packageRules: [
    {
      matchDatasources: ["docker"],
      matchPackageNames: ["ghcr.io/linuxserver/calibre-web"],
      allowedVersions: "<1",
    },
    {
      matchDatasources: ["docker"],
      matchPackageNames: ["tomsquest/docker-radicale"],
      allowedVersions: "/^[0-9]+\\.[0-9]+\\.[0-9]+(\\.[0-9]+)?$/",
    },
    {
      matchDatasources: ["docker"],
      matchPackageNames: ["docker.io/kopia/kopia"],
      allowedVersions: "<999",
    },
    {
      matchDatasources: ["helm"],
      matchPackageNames: ["intel-device-plugins-gpu", "intel-device-plugins-operator"],
      allowedVersions: "!/^0\\.37\\.2$/",
    },
    {
      matchDatasources: ["docker"],
      matchPackageNames: ["ghcr.io/home-operations/charts-mirror/ceph-csi-drivers"],
      allowedVersions: "<1.1.0",
    },
    {
      matchDatasources: ["docker"],
      matchPackageNames: ["quay.io/ceph/ceph"],
      allowedVersions: "<21",
    },
  ],
}